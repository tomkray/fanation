# Fanation Club — copy to .env (never commit .env, never paste tokens in chat).

# Local toy only. `npm run dev` turns this on by itself and writes data/ledger.demo.jsonl.
# The published planet leaves this unset, so the book starts empty.
# FANATION_DEMO=1
HOST=127.0.0.1
PORT=8787

# --- Instagram: @fanation.club (Instagram API with Instagram Login) ---
# Token of the professional account, scopes instagram_business_basic +
# instagram_business_manage_comments (+ instagram_business_content_publish for the video agent).
# With a token set, `npm run dev` reads the real comments instead of simulated ones.
FANATION_IG_ACCESS_TOKEN=
FANATION_IG_USERNAME=fanation.club
# `me` = the token's own account.
FANATION_IG_USER_ID=me
FANATION_GRAPH_BASE_URL=https://graph.instagram.com/v23.0
# query (Meta's documented form) | header
FANATION_GRAPH_TOKEN_TRANSPORT=query
# How often the collector reads the latest posts (seconds) and how many posts.
FANATION_POLL_INTERVAL_SECONDS=60
FANATION_POLL_MEDIA_LIMIT=10

# Real-time webhook (optional; needs a public HTTPS URL such as https://fanation.club).
FANATION_META_APP_SECRET=
FANATION_META_VERIFY_TOKEN=

# --- City ---
FANATION_TIER_COHORT=10000
# Real fans: data/ledger.jsonl · simulated demo: data/ledger.demo.jsonl (never mix them).
# The real file is not in git. A missing file boots an empty city.
# FANATION_JOURNAL_PATH=
# Instagram comments older than this instant are ignored. Required for the real planet.
# Set it to the minute the first video goes out, so only new owners mint.
# FANATION_LIVE_FROM=2026-10-16T18:00:00.000Z
# Postgres on Vercel. The process does not read this yet; the journal is still the file above.
# DATABASE_URL=

# --- Payments (only when a rail is set; the city still opens on comments alone) ---
FANATION_PAYMENT_WEBHOOK_SECRET=
FANATION_PIX_KEY=
FANATION_PIX_MERCHANT_NAME=FANATION CLUB
FANATION_PIX_MERCHANT_CITY=SAO PAULO
FANATION_USDT_ADDRESS=
FANATION_USDT_NETWORK=
FANATION_USDC_ADDRESS=
FANATION_USDC_NETWORK=
FANATION_BTC_ADDRESS=
FANATION_BTC_NETWORK=

# --- The map reorganizes around the fan tree once per epoch of comment time (default 60 demo / 600 real) ---
FANATION_LAYOUT_EPOCH_SECONDS=

# --- $FANT seasons: reputation earned in a season is paid when it ends (default 300 demo / 604800 = 7 days real) ---
FANATION_SEASON_SECONDS=

# --- Partner ads (zeppelins, billboards, sky banners) ---
# Admin token (24+ chars) to review requests at /api/v1/admin/ads; admin routes are off when empty.
FANATION_ADMIN_TOKEN=
FANATION_ADS_PATH=data/ads.json

# --- Profile pictures (Instagram Business Discovery) ---
# A second token, from a professional account via Facebook login. Off when empty.
# Every @ already in the city is queued. The copy is small, stored on disk, and
# served at /api/v1/avatars/:handle. Personal accounts have no official picture
# and keep the colored initial. At most 400 lookups an hour.
FANATION_DISCOVERY_ACCESS_TOKEN=
FANATION_DISCOVERY_IG_USER_ID=
FANATION_DISCOVERY_BASE_URL=https://graph.facebook.com/v23.0
FANATION_AVATAR_DIR=data/avatars
# One pipeline: every mint enqueues portraits. Without Discovery the API uses
# the public profile og:image. Escape hatch (same cache only):
#   npm run avatar:seed -- handle [file-or-url]


# --- Local Muse dump door (optional; 24+ chars). Off when empty. ---
# Paste Muse JSON into a file, then: npm run muse:ingest -- that-file.json
# FANATION_BRIDGE_SECRET=

# --- ElevenLabs character voice for reels (never commit the real key) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# --- AI video agent (reuses FANATION_IG_ACCESS_TOKEN for Reels) ---
FANATION_API_URL=http://127.0.0.1:8787
FANATION_FRONTEND_URL=http://127.0.0.1:5173
FANATION_RENDER_DIR=renders
TIKTOK_ACCESS_TOKEN=
